{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dry-run-tutor",
  // Add "account_id" here if your Cloudflare login sees more than one account.
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Secrets (never committed): INSTALL_HMAC_SECRET, and one operator credential
  // per trial pool member, each named by that member's `secret_binding` in
  // contracts/config.schema.json — TRIAL_KEY_GROQ at minimum. Trial path only,
  // never the learner-keyed path (FR-025). Also TURNSTILE_SECRET
  // (feature 007, web-only routes), and STT_KEY_GROQ (operator Groq key for
  // server-side speech-to-text, feature 008). Pro Plus (feature 009) adds
  // PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET and PAYPAL_WEBHOOK_ID (sandbox only).
  "ratelimits": [
    { "name": "WEB_EVENT_RL", "namespace_id": "7003", "simple": { "limit": 30, "period": 60 } },
    { "name": "INSTALL_RL", "namespace_id": "7004", "simple": { "limit": 5, "period": 60 } },
    { "name": "PRO_RL", "namespace_id": "7005", "simple": { "limit": 5, "period": 60 } }
  ],
  "env": {
    "dev": {
      "name": "dry-run-tutor-dev",
      "vars": {
        "ENVIRONMENT": "dev"
      },
      "d1_databases": [
        {
          "binding": "DB",
          // Create your own: `npx wrangler d1 create dry-run-tutor-dev`, then
          // paste the id it prints.
          "database_name": "dry-run-tutor-dev",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "WEB_EVENT_RL", "namespace_id": "7003", "simple": { "limit": 30, "period": 60 } },
        { "name": "INSTALL_RL", "namespace_id": "7004", "simple": { "limit": 5, "period": 60 } },
        { "name": "PRO_RL", "namespace_id": "7005", "simple": { "limit": 5, "period": 60 } }
      ]
    },
    "prod": {
      "name": "dry-run-tutor",
      "vars": {
        "ENVIRONMENT": "prod"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dry-run-tutor",
          "database_id": "32d250f0-a163-4051-b93d-b18f72904238",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "WEB_EVENT_RL", "namespace_id": "7003", "simple": { "limit": 30, "period": 60 } },
        { "name": "INSTALL_RL", "namespace_id": "7004", "simple": { "limit": 5, "period": 60 } },
        { "name": "PRO_RL", "namespace_id": "7005", "simple": { "limit": 5, "period": 60 } }
      ]
    },
    // Pro Plus (feature 009): a separate deployment for the PayPal entry, with its
    // own D1 and `config` row (research.md R-16). Never share secrets or a database
    // with prod.
    "paypal": {
      "name": "dry-run-tutor-paypal",
      "vars": {
        "ENVIRONMENT": "paypal"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dry-run-tutor-paypal",
          "database_id": "71b6a14b-1d7a-4eac-899c-12da0ba29214",
          "migrations_dir": "migrations"
        }
      ],
      "ratelimits": [
        { "name": "WEB_EVENT_RL", "namespace_id": "7003", "simple": { "limit": 30, "period": 60 } },
        { "name": "INSTALL_RL", "namespace_id": "7004", "simple": { "limit": 5, "period": 60 } },
        { "name": "PRO_RL", "namespace_id": "7005", "simple": { "limit": 5, "period": 60 } }
      ]
    }
  }
}
