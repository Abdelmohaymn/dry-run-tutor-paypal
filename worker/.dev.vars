# Local dev / test-only values. NOT real credentials — TRIAL_KEY_GROQ is
# never dialled in unit or contract tests (provider is stubbed with
# fetchMock); it exists here only so the binding is defined. Override with
# your own values for a real `npm run dev` session against a live provider.
INSTALL_HMAC_SECRET="local-dev-install-hmac-secret-do-not-use-in-prod"
TRIAL_KEY_GROQ="local-dev-placeholder-not-a-real-key"
# STT_KEY_GROQ (server-side speech-to-text) is likewise a placeholder: the
# Groq transcription call is stubbed with fetchMock in tests, never dialled.
STT_KEY_GROQ="local-dev-placeholder-not-a-real-stt-key"
# A second trial-pool-member binding, test-only — exercised by
# trial-pool.test.ts and trial.test.ts to prove routing across >1 member
# (SC-010c). No corresponding config.schema.json pool entry ships by
# default; tests add one to config themselves.
TRIAL_KEY_TEST2="local-dev-placeholder-not-a-real-key-2"
# Feature 007, web-only routes. TURNSTILE_SECRET is Cloudflare's always-pass
# test secret (challenges.cloudflare.com/turnstile — dashboard docs).
TURNSTILE_SECRET="1x0000000000000000000000000000000AA"
# Feature 009 (Pro Plus). Placeholders only: PayPal is stubbed with fetchMock in
# tests and never dialled.
PAYPAL_CLIENT_ID="test-client"
PAYPAL_CLIENT_SECRET="test-secret"
PAYPAL_WEBHOOK_ID="WH-TEST"
